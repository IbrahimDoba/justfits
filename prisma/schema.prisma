// JUSTFITS E-Commerce Platform - Prisma Schema
// Production-grade schema with performance optimization and scalability

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// AUTHENTICATION (NextAuth.js)
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// USER MANAGEMENT
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(CUSTOMER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Auth Relations
  accounts Account[]
  sessions Session[]

  // E-commerce Relations
  addresses Address[]
  orders    Order[]
  cart      Cart?
  reviews   Review[]
  wishlist  WishlistItem[]

  // Loyalty Relations
  loyaltyCard    LoyaltyCard?
  loyaltyRewards LoyaltyReward[]

  @@index([email])
  @@map("users")
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

model Address {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName  String
  lastName   String
  phone      String
  street     String
  city       String
  state      String
  country    String  @default("Nigeria")
  postalCode String
  isDefault  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// ============================================
// PRODUCT CATALOG
// ============================================

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  products Product[]

  @@index([slug])
  @@index([parentId])
  @@map("categories")
}

model Product {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String
  basePrice   Decimal @db.Decimal(10, 2)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  featured Boolean @default(false)
  isActive Boolean @default(true)

  // SEO
  metaTitle       String?
  metaDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  variants      ProductVariant[]
  images        ProductImage[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  sales         Sale[]

  @@index([slug])
  @@index([categoryId])
  @@index([featured])
  @@map("products")
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku  String @unique
  name String // e.g., "Mercedes-Benz Classic Black - Medium"

  // Car theme specifics (can be null for non-car products)
  carBrand String? // Mercedes-Benz, BMW, Porsche
  color    String
  size     String // S, M, L, XL, etc.

  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2) // For showing discounts

  stockQuantity     Int @default(0)
  lowStockThreshold Int @default(5)

  isAvailable Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@index([sku])
  @@index([isAvailable])
  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url       String
  alt       String?
  position  Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([isPrimary])
  @@map("product_images")
}

// ============================================
// SHOPPING CART
// ============================================

model Cart {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id     String @id @default(cuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

// ============================================
// ORDERS & PAYMENTS
// ============================================

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  userId     String?
  user       User?   @relation(fields: [userId], references: [id])
  guestEmail String?

  addressId       String
  shippingAddress Address @relation(fields: [addressId], references: [id])

  status OrderStatus @default(PENDING)

  subtotal     Decimal @db.Decimal(10, 2)
  shippingCost Decimal @db.Decimal(10, 2)
  tax          Decimal @db.Decimal(10, 2)
  total        Decimal @db.Decimal(10, 2)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  items   OrderItem[]
  payment Payment?

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  quantity Int
  price    Decimal @db.Decimal(10, 2) // Price at time of order

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("NGN")

  status PaymentStatus @default(PENDING)
  method PaymentMethod

  // Payment gateway details
  transactionId  String? @unique
  paymentGateway String? // Paystack, Flutterwave, etc.
  receiptUrl     String? // For bank transfers
  metadata       Json?   // Additional payment data

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([transactionId])
  @@map("payments")
}

model StoreSetting {
  id String @id @default("default")

  // Store Info
  storeName  String? @default("JUSTFITS")
  storeEmail String? @default("support@justfits.com")
  storePhone String? @default("+234 800 000 0000")

  // Bank Details
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?

  // Pricing & Shipping
  currency              String @default("NGN")
  taxRate               Float  @default(0)
  shippingFee           Float  @default(2500)
  freeShippingThreshold Float? @default(50000)

  // Shipping & Delivery
  deliveryTimeline String? @default("3-5 business days within Lagos, 5-7 business days nationwide")

  // Inventory
  lowStockThreshold Int @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("store_settings")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  PAYSTACK
  FLUTTERWAVE
}

// ============================================
// REVIEWS & WISHLIST
// ============================================

model Review {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating  Int // 1-5
  title   String?
  comment String

  isVerified  Boolean @default(false) // Verified purchase
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@index([isPublished])
  @@map("reviews")
}

model WishlistItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

// ============================================
// SHIPPING ZONES
// ============================================

model ShippingZone {
  id    String @id @default(cuid())
  state String @unique // slug, e.g. "lagos"
  label String          // display name, e.g. "Lagos"

  price                 Float  // shipping fee for this state
  freeShippingThreshold Float? // null = use global StoreSetting threshold

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state])
  @@map("shipping_zones")
}

// ============================================
// LOYALTY PROGRAM
// ============================================

model LoyaltyCard {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stamps             Int @default(0) // Current stamps (resets after reward)
  totalStampsEarned  Int @default(0) // Lifetime stamps earned
  totalRewardsEarned Int @default(0) // Total rewards unlocked

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("loyalty_cards")
}

model LoyaltyReward {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  code            String @unique // Unique redemption code
  discountPercent Int    @default(30) // 30% off

  isRedeemed Boolean   @default(false)
  redeemedAt DateTime?
  expiresAt  DateTime // Reward expires after certain time

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([code])
  @@index([isRedeemed])
  @@map("loyalty_rewards")
}

// ============================================
// FINANCE — OFFLINE SALES & EXPENSES LEDGER
// ============================================

model Sale {
  id String @id @default(cuid())

  date          DateTime
  customerName  String
  customerPhone String? // For new-stock reminder messages
  productText   String // Free text as kept in the sheet, e.g. "Benz/Ferrari"
  variantText  String? // Colours/variant description, e.g. "Black/Pink & Black (AMG)"

  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(10, 2)

  deliveryFee    Decimal? @db.Decimal(10, 2)
  deliveryPaidBy String? // Him / Her / Me / Both / Pickup / None
  location       String? // Delivery/sale location (new records only)

  totalCollected Decimal  @db.Decimal(10, 2)
  profit         Decimal? @db.Decimal(10, 2) // null = "None yet"

  paymentStatus SalePaymentStatus @default(PAID)
  notes         String?

  // Optional catalog link (new sales only)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id])
  deductedStock Boolean  @default(false)

  // Itemised line items (new sales that pick from inventory)
  items SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([customerName])
  @@index([paymentStatus])
  @@map("sales")
}

model SaleItem {
  id     String @id @default(cuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  // Loose link to inventory (item may later be renamed/removed); name/size are
  // snapshotted so the sale record stays accurate regardless.
  inventoryItemId String?
  name            String
  size            String?

  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(10, 2) // price this item was sold at

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([inventoryItemId])
  @@map("sale_items")
}

model Expense {
  id String @id @default(cuid())

  date        DateTime
  category    ExpenseCategory
  description String?
  amount      Decimal         @db.Decimal(10, 2)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([category])
  @@map("expenses")
}

enum SalePaymentStatus {
  PAID
  PARTIAL
  PENDING
}

enum ExpenseCategory {
  STOCK
  PACKAGING
  ADS
  DELIVERY
  LOSS
  RENT
  SALARIES
  FEES
  OTHER
}

// ============================================
// INVENTORY — offline stock the finance ledger draws from
// ============================================

model InventoryItem {
  id String @id @default(cuid())

  name     String
  brand    String? // e.g. Benz, BMW, Ferrari
  category InventoryCategory @default(OTHER) // CAP / SHIRT / OTHER — drives grouping & filters
  size     String? // e.g. L, XL, XXL, 3XL for shirts; null for one-size caps
  sku      String?

  costPrice    Decimal? @db.Decimal(10, 2) // what it costs you
  sellingPrice Decimal? @db.Decimal(10, 2) // default sale price
  quantity     Int      @default(0) // units in stock

  notes String?

  // Optional, loose reference to a catalog product (no FK — inventory is
  // managed independently of the storefront).
  productId String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([productId])
  @@index([category])
  @@map("inventory_items")
}

enum InventoryCategory {
  CAP
  SHIRT
  OTHER
}

// ============================================
// ADMIN NOTES — free-form ledger for important notes
// ============================================

model AdminNote {
  id String @id @default(cuid())

  title   String?
  content String  @db.Text

  pinned Boolean @default(false)

  authorName  String? // who wrote it (snapshot of session name/email)
  authorEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pinned])
  @@index([updatedAt])
  @@map("admin_notes")
}
